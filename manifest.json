{
  "manifest_version": 3,
  "name": "Quick Preview",
  "version": "1.0",
  "description": "Live preview any link by hovering.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}